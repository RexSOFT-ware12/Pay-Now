NODE_ENV=production
PORT=8088
PUBLIC_BASE_URL=https://payments.fabricnow.pro          # e.g. https://fabricnow-pay.onrender.com

MONGODB_URI=mongodb+srv://...                        # must be reachable from Render
# MUST be the SAME Paystack account/secret key that Style and Qwesi use today
# (Paystack signs every webhook with this key). Live key for live webhooks.
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=                             # leave blank: Paystack signs with the secret key

# Secret used by apps that call this gateway's /v1/* endpoints (min 32 random chars)
GATEWAY_INTERNAL_SECRET=replace_with_32_plus_random_chars
ADMIN_API_KEY=replace_with_long_random_admin_key

# ---- STYLE (FabricNow) ----------------------------------------------------
# Where the gateway forwards Style's events. Must be Style's LIVE API host.
STYLE_EVENT_URL=https://backend.fabricnow.pro/api/payments/paystack-events
# Must equal FABRIC_PAY_EVENT_SECRET in the Style backend.
STYLE_EVENT_SECRET=replace_with_style_shared_secret
# Paystack plan codes Style sells (Premium, API Starter, API Growth). Used to route renewals.
STYLE_PLAN_CODES=PLN_premium,PLN_api_starter,PLN_api_growth
# Only needed if Style starts creating checkouts THROUGH the gateway (not needed for webhook routing)
STYLE_CALLBACK_URL=https://fabricnow.pro/account?upgraded=1&billing=success

# ---- QWESI (Hospital) -----------------------------------------------------
# Hospital's LIVE API host + the new gateway receiver route.
QWESI_EVENT_URL=https://<hospital-live-host>/api/payment/webhook/fabric-pay
# Must equal FABRIC_PAY_EVENT_SECRET in the Hospital backend.
QWESI_EVENT_SECRET=replace_with_qwesi_shared_secret
QWESI_PLAN_CODES=                                    # Qwesi sells one-off credits, no plans
QWESI_CALLBACK_URL=https://<hospital-live-host>/api/payment/return
