NODE_ENV=development
PORT=8088
PUBLIC_BASE_URL=https://payments.fabricnow.pro
MONGODB_URI=MONGODB_URI=mongodb://<username>:<password>@ac-craroub-shard-00-00.erjhy7a.mongodb.net:27017,ac-craroub-shard-00-01.erjhy7a.mongodb.net:27017,ac-craroub-shard-00-02.erjhy7a.mongodb.net:27017/fabricnow_pay?ssl=true&replicaSet=atlas-df1qfv-shard-0&authSource=admin
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxx
# Secret used by each app to authenticate requests from this gateway (min 32 random chars)
GATEWAY_INTERNAL_SECRET=replace_with_32_plus_random_chars
# Callback URLs must be allowlisted to avoid open redirects. Separate per app:
STYLE_CALLBACK_URL=https://fabricnow.pro/billing/paystack/callback
QWESI_CALLBACK_URL=https://backend-hospital-chv4.onrender.com/payment/callback
# App routing targets (the gateway signs forwarded events with X-Fabric-Pay-Signature)
STYLE_EVENT_URL=https://api.fabricnow.pro/api/payments/paystack-events
STYLE_EVENT_SECRET=replace_with_style_backend_shared_secret
QWESI_EVENT_URL=https://backend-hospital-chv4.onrender.com/api/payment/webhook/paystack
QWESI_EVENT_SECRET=replace_with_qwesi_shared_secret
# Plan allowlists: comma-separated Paystack plan codes, per app
STYLE_PLAN_CODES=PLN_xxx,PLN_yyy
QWESI_PLAN_CODES=
# Optional IP allowlist for admin endpoints; keep blank only for local development
ADMIN_API_KEY=replace_with_long_random_admin_key


